{
  "$description": "Meta Sun · tokens do design system, v0.1 (rascunho). Itens com \"provisional\": true dependem de dado a confirmar.",
  "color": {
    "sol":        { "value": "#F7A21B", "use": "Símbolo, botões, ícones, números sobre fundo escuro. Nunca texto sobre claro." },
    "grafite":    { "value": "#1C1C1C", "use": "Texto, fundos escuros, texto de botão laranja." },
    "branco":     { "value": "#FFFFFF", "use": "Fundo principal." },
    "areia":      { "value": "#F5F3EF", "use": "Fundo secundário." },
    "cinza-texto":{ "value": "#6B6B6B", "use": "Texto de apoio sobre branco e areia." },
    "sol-texto":  { "value": "#A65800", "use": "Texto laranja e números grandes sobre branco e areia." },
    "marinho":    { "value": "#14284B", "use": "Blocos de destaque e BESS.", "provisional": true, "note": "HEX a confirmar." },
    "derived": {
      "sol-hover":      { "value": "#E8910B", "provisional": true },
      "sol-ativo":      { "value": "#D17F00", "provisional": true },
      "desabilitado":   { "value": "#E9E6DF", "provisional": true },
      "apoio-sobre-escuro": { "value": "#BDB9B0", "provisional": true },
      "linha":          { "value": "#E3DFD6", "provisional": true },
      "linha-escura":   { "value": "#3A3A3A", "provisional": true },
      "erro":           { "value": "#B3261E", "provisional": true },
      "erro-sobre-escuro": { "value": "#FFB4AB", "provisional": true },
      "provisorio-fundo": { "value": "#FFF4DF", "provisional": true }
    }
  },
  "proportion": { "claro": "60% (branco e areia)", "escuro": "25% (grafite, azul-marinho nos destaques)", "laranja": "15%" },
  "contrast": {
    "grafite/branco": 17.0, "grafite/areia": 15.4, "grafite/sol": 8.2,
    "branco/sol": 2.1, "sol/branco": 2.1, "sol-texto/branco": 5.2, "sol-texto/areia": 4.7,
    "cinza-texto/branco": 5.3, "cinza-texto/areia": 4.8,
    "sol/grafite": 8.2, "sol/marinho": 7.1, "branco/marinho": 14.6, "apoio-escuro/grafite": 8.7, "erro/branco": 6.6,
    "note": "Razões WCAG 2.x arredondadas. Recalcular o marinho quando o HEX for confirmado."
  },
  "font": {
    "family": "Montserrat, Arial, sans-serif",
    "weights": { "regular": 400, "semibold": 600, "bold": 700 },
    "load": "Google Fonts, pesos 400, 600 e 700, subconjunto latino, font-display: swap"
  },
  "type": {
    "display":   { "weight": 700, "size": "clamp(36px, 6.4vw, 68px)", "lineHeight": 1.04, "tracking": "-0.02em" },
    "h2":        { "weight": 700, "size": "clamp(28px, 4.2vw, 44px)", "lineHeight": 1.12, "tracking": "-0.015em" },
    "h3":        { "weight": 700, "size": "clamp(19px, 2.2vw, 22px)", "lineHeight": 1.25 },
    "lead":      { "weight": 400, "size": "clamp(17px, 2vw, 20px)", "lineHeight": 1.55 },
    "body":      { "weight": 400, "size": "16px", "lineHeight": 1.6, "maxMeasure": "68ch" },
    "label":     { "weight": 600, "size": "12px", "lineHeight": 1.4, "tracking": "0.12em", "transform": "uppercase" },
    "number-xl": { "weight": 700, "size": "clamp(64px, 9vw, 112px)", "lineHeight": 1, "tracking": "-0.03em", "numeric": "tabular-nums" }
  },
  "space": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "6": "24px", "8": "32px", "12": "48px", "16": "64px", "24": "96px", "32": "128px" },
  "layout": { "container": "1120px", "gutter": "clamp(20px, 5vw, 64px)", "section-y": "clamp(56px, 9vw, 104px)", "breakpoints": { "sm": "640px", "md": "900px", "lg": "1200px" } },
  "radius": { "campo": "6px", "botao": "8px", "card": "12px" },
  "border": { "filete": "1px", "traco": "2px", "foco": "3px", "foco-offset": "3px" },
  "elevation": { "value": "flat", "note": "Sem sombra. Hierarquia por fundo, filete de 1 px e traço de 2 px." },
  "icon": { "style": "line", "stroke": "1.75px", "grid": "24px", "color": "sol", "note": "Ícone laranja é enfeite: o significado vai em texto. Ícone que age sozinho fica em grafite." },
  "target": { "min": "44px", "button": "48px", "whatsapp": "56px" },
  "motion": {
    "fast": "150ms", "base": "250ms", "slow": "600ms", "count": "1600ms", "arc": "1200ms", "stagger": "80ms",
    "ease": "cubic-bezier(0.2, 0.7, 0.2, 1)",
    "reducedMotion": "Estado final imediato, sem transição. Conteúdo completo visível sem animação."
  },
  "logo": {
    "status": "aguardando arquivos oficiais",
    "provisional": true,
    "allowedBackgrounds": ["branco", "areia", "grafite"],
    "clearSpace": null,
    "minSize": null,
    "rule": "Só arquivos oficiais, sem alterar. Nenhum logo desenhado."
  }
}
